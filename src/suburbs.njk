---
layout: base
pagination:
  data: suburbsList
  size: 1
  alias: suburb
permalink: "suburbs/{{ suburb.slug }}/index.html"
eleventyComputed:
  # Title test (24 Oct 2026): new "xxxx: xxxx" format on 2 pages first; roll out if they hold.
  title: "{% if suburb.slug == 'rouse-hill' or suburb.slug == 'cherrybrook' %}Mac Repair {{ suburb.name }}: MacBook & iMac, From $119{% else %}Mac Repair {{ suburb.name }} | {{ suburb.titleDriver }}{% endif %}"
  description: "Mac repair in {{ suburb.name }}. MacBook and iMac repairs with honest diagnostics and transparent pricing. Battery, screen, data recovery, logic board repair. Workshop based service."
