<script>
(function () {
  var go = document.getElementById('spillGo');
  if (!go) return;
  function val(name) { var el = document.querySelector('input[name="' + name + '"]:checked'); return el ? el.value : null; }
  go.addEventListener('click', function () {
    var liquid = val('liquid'), time = val('time'), power = val('power'), amount = val('amount'), state = val('state');
    var msg = document.getElementById('spillMsg'), out = document.getElementById('spillResult');
    if ([liquid, time, power, amount, state].indexOf(null) !== -1) { msg.hidden = false; return; }
    msg.hidden = true;
    var stateScore = { fine: 0, untested: 1, partial: 2, dead: 3 }[state];
    var score = (+liquid) + (+time) + (+power) + (+amount) + stateScore;
    var level, cls;
    if (score <= 3) { level = 'Lower risk'; cls = 'r1'; }
    else if (score <= 6) { level = 'Medium risk'; cls = 'r2'; }
    else if (score <= 9) { level = 'High risk'; cls = 'r3'; }
    else { level = 'Very high risk'; cls = 'r4'; }
    var todo = [];
    if (power !== '0' || state === 'untested' || state === 'fine') todo.push('Turn it off now: hold the power button for 10 seconds. Don’t charge it.');
    todo.push('Unplug everything, then stand it upside down like a tent, keyboard facing down.');
    if (state === 'fine') todo.push('If your files aren’t backed up, copy only the most important ones first, then turn it off. Keep the charger out.');
    if (liquid === '3') todo.push('Salt and pool water corrode fastest. Bring it in today.');
    if (+time >= 2) todo.push('Corrosion has had time to start. Book it in this week, even if it seems fine.');
    todo.push('Call 02 4509 9248. Tell us what spilled and when.');
    var repair;
    if (state === 'dead') repair = 'Board repair is likely: from $249. If you need the files and have no backup, we get those out first (from $199).';
    else if (state === 'partial') repair = 'A clean plus replacing the parts that failed. Keyboard or trackpad from $129. Ports or board parts from $249.';
    else repair = 'If we find no failed parts, an ultrasonic clean and dry: from $150.';
    var html = '<p class="res-level"><span class="risk ' + cls + '">' + level + '</span></p>' +
      '<h3>Do this now</h3><ol>' + todo.map(function (t) { return '<li>' + t + '</li>'; }).join('') + '</ol>' +
      '<h3>Likely repair</h3><p>' + repair + ' The $150 inspection comes off the repair if you go ahead.</p>' +
      '<p class="fine">This is a guide only. We confirm the real fault and price after we open it.</p>' +
      '<p><a class="btn large" href="tel:0245099248">Call 02 4509 9248</a></p>';
    out.innerHTML = html; out.hidden = false;
    out.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
  });
})();
</script>

