<!DOCTYPE html>
<html lang="en-AU">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="robots" content="index, follow">
  <link rel="canonical" href="https://www.hillsmacrepair.com.au{{ page.url }}">
  <link rel="icon" href="/favicon.ico?v=3" sizes="16x16 32x32 48x48">
  <link rel="icon" href="/assets/img/icon-192.png?v=3" type="image/png" sizes="192x192">
  <link rel="apple-touch-icon" href="/apple-touch-icon.png?v=3">
  <link rel="manifest" href="/site.webmanifest?v=3">
  <meta name="theme-color" content="#1D4ED8">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/assets/css/style.css?v=20261024">
  <title>{{ title or 'Hills District Mac Repair' }}</title>
  <meta name="description" content="{{ description or 'Professional Mac repair services in the Hills District Sydney. MacBook, iMac repairs with same-day service. Battery, screen, keyboard, data recovery. Call 02 4509 9248.' }}">
</head>
<body>
<header class="site-header">
  <div class="wrap">
    <a href="/" class="logo-link" aria-label="Hills Mac Repair home">
      <img class="logo-img" src="/assets/img/logo.webp?v=3" width="600" height="362" alt="Hills Mac Repair">
    </a>
    <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="site-nav"><span class="bars" aria-hidden="true"></span>Menu</button>
    <nav class="nav" id="site-nav" aria-label="Main">
      <a href="/">Home</a>
      <a href="/macbook-problems/">MacBook Problems</a>
      <div class="dropdown">
        <a href="/services/" class="dropdown-trigger">Services ▾</a>
        <div class="dropdown-menu">
          <a href="/services/">All Services</a>
          {% for service in servicesList %}
          <a href="/services/{{ service.slug }}/">{{ service.shortName }}</a>
          {% endfor %}
          <div class="dropdown-divider"></div>
          <a href="/imac-upgrades/">iMac Upgrades</a>
        </div>
      </div>
      <a href="/suburbs/">Suburbs</a>
      <a href="/pages/booking/">Booking</a>
      <a href="/pages/contact/">Contact</a>
    </nav>
    <div class="header-actions">
      <a class="header-phone" href="tel:0245099248">02 4509 9248</a>
      <a class="btn header-cta" href="/pages/booking/">Get a price</a>
    </div>
  </div>
</header>

{% if fullBleed %}
{{ content | safe }}
{% else %}
<main class="wrap">
{{ content | safe }}
</main>
{% endif %}

<footer class="site-footer">
  <div class="wrap">
    <div class="footer-grid">
      <div>
        <a href="/" class="footer-logo"><img src="/assets/img/logo.webp?v=3" width="600" height="362" alt="Hills Mac Repair" loading="lazy"></a>
        <p>MacBook and iMac repairs at our Hills District workshop. Call for a free phone estimate.</p>
        <a class="footer-phone" href="tel:0245099248">02 4509 9248</a>
        <p>New parts: 12-month warranty. Used or aftermarket parts: 30 days.</p>
      </div>
      <div>
        <h4>Repairs</h4>
        <ul>
          {% for service in servicesList %}
          <li><a href="/services/{{ service.slug }}/">{{ service.shortName }}</a></li>
          {% endfor %}
        </ul>
      </div>
      <div>
        <h4>Help</h4>
        <ul>
          <li><a href="/macbook-problems/">MacBook problems</a></li>
          <li><a href="/imac-upgrades/">iMac upgrades</a></li>
          <li><a href="/suburbs/">Suburbs we cover</a></li>
          <li><a href="/pages/booking/">Book a repair</a></li>
          <li><a href="/pages/contact/">Contact</a></li>
        </ul>
      </div>
    </div>
    <div class="footer-bottom">
      <span>Independent specialist — not affiliated with Apple Inc.</span>
      <span class="footer-links"><a href="/terms/">Terms &amp; Conditions</a><a href="/privacy/">Privacy Policy</a></span>
    </div>
  </div>
</footer>

<div class="mobile-bar">
  <a class="call" href="tel:0245099248">Call 02 4509 9248</a>
  <a class="quote" href="/pages/booking/">Get a price</a>
</div>

<script>
document.addEventListener('DOMContentLoaded', function () {
  var toggle = document.querySelector('.nav-toggle');
  var nav = document.getElementById('site-nav');
  if (toggle && nav) {
    toggle.addEventListener('click', function () {
      var open = nav.classList.toggle('open');
      toggle.setAttribute('aria-expanded', open ? 'true' : 'false');
    });
  }
  var dropdowns = document.querySelectorAll('.dropdown');
  dropdowns.forEach(function (dropdown) {
    var trigger = dropdown.querySelector('.dropdown-trigger');
    trigger.addEventListener('click', function (e) {
      if (window.innerWidth <= 860 || 'ontouchstart' in window) {
        e.preventDefault();
        dropdown.classList.toggle('open');
      }
    });
  });
  document.addEventListener('click', function (e) {
    dropdowns.forEach(function (dropdown) {
      if (!dropdown.contains(e.target)) { dropdown.classList.remove('open'); }
    });
  });
  document.querySelectorAll('.dropdown-menu a').forEach(function (link) {
    link.addEventListener('click', function () {
      dropdowns.forEach(function (dropdown) { dropdown.classList.remove('open'); });
    });
  });
});
</script>
</body>
</html>
