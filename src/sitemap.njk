---
permalink: /sitemap.xml
eleventyExcludeFromCollections: true
---
{%- set base = "https://www.hillsmacrepair.com.au" -%}
{%- set today = "2026-10-25" -%}
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  <url><loc>{{ base }}/</loc><lastmod>{{ today }}</lastmod></url>
  <url><loc>{{ base }}/shop/</loc><lastmod>{{ today }}</lastmod></url>
  {%- for item in shop.all %}
  <url><loc>{{ base }}/product/{{ item.slug }}/</loc><lastmod>{{ today }}</lastmod></url>
  {%- endfor %}
  <url><loc>{{ base }}/imac-upgrades/</loc><lastmod>{{ today }}</lastmod></url>
  <url><loc>{{ base }}/suburbs/</loc><lastmod>{{ today }}</lastmod></url>
  {%- for suburb in suburbsList %}
  <url><loc>{{ base }}/suburbs/{{ suburb.slug }}/</loc></url>
  {%- endfor %}
  <url><loc>{{ base }}/repair-case-studies/</loc><lastmod>{{ today }}</lastmod></url>
  {%- for p in collections.all %}{% if p.url and p.url.startsWith('/repair-case-studies/') and p.url != '/repair-case-studies/' %}
  <url><loc>{{ base }}{{ p.url }}</loc><lastmod>{{ today }}</lastmod></url>
  {%- endif %}{% endfor %}
  <url><loc>{{ base }}/macbook-glossary/flexgate/</loc><lastmod>{{ today }}</lastmod></url>
  <url><loc>{{ base }}/about-the-technician/</loc></url>
  <url><loc>{{ base }}/pages/booking/</loc><lastmod>{{ today }}</lastmod></url>
  <url><loc>{{ base }}/pages/contact/</loc></url>
  <url><loc>{{ base }}/terms/</loc></url>
  <url><loc>{{ base }}/privacy/</loc></url>
</urlset>
